 "$comment": "Not in Sketch swatches/styles: carried over from silica-desktop docs/design/amalfi (tokens.json, motion.md). Colours, typography and glass styles come from the Sketch export.",
 "unit": "pt (1 pt = 1 logical px)",
 "grid": {
  "base": 4,
  "rule": "every frame x, y, width, height is a multiple of 4; no half points; text frames on whole points"
 },
 "spacing": {
  "xs": 4,
  "s": 8,
  "m": 12,
  "l": 16,
  "xl": 20,
  "xxl": 24,
  "padding": {
   "regularWindow": 20,
   "compactWindowAndPanel": 16,
   "documentAndSettings": 24
  }
 },
 "controlHeights": {
  "mini": 20,
  "small": 24,
  "regular": 28,
  "large": 32,
  "note": "one scale for every control; toolbar items are 36 (user decision 2026-10-17, macOS capsules are 38); never resize a control inside a bar",
  "toolbar": 36
 },
 "controlIcons": {
  "mini": 14,
  "small": 16,
  "regular": 20,
  "large": 20,
  "toolbar": 20,
  "accessory": 16,
  "menuBar": 20,
  "sidebar": 20,
  "list": 20,
  "note": "user decision 2026-10-17: Amalfi symbols draw ink = size x 20/24, so a 20 pt symbol draws ~17 pt like macOS; never smaller. Icons are set in the Silica Symbols font (silica-icons fonts/): font size = icon size"
 },
